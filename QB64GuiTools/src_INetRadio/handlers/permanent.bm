    GOSUB MainLoop_PermanentHandler 'this logic looks weird, but keep it that way
    GOTO MainLoop_SkipPermanentHandler
    'This handler is called permanently on a regular pace. Depending on the
    'application's current activity the calling frequency will vary between
    '25-50 FPS, in rare cases it may drop down to 10 FPS. That said, this
    'handler shouldn't be used as a stable timing base. However, it may be
    'used for background operations such as downloading/streaming data.
    MainLoop_PermanentHandler:
        IF nowPlaying% AND stream& <> 0 THEN
            GOSUB streamPlay
            GOSUB feedsControl
        END IF
        IF editing% THEN
            IF NOT GuiViewIsOpen%(EditView&) THEN
                ok$ = GenC$("SET", StationsDeleteButton$ + NewTag$("DISABLED", "false"))
                ok$ = GenC$("SET", StationsImportButton$ + NewTag$("DISABLED", "false"))
                ok$ = GenC$("SET", StationsChangeButton$ + NewTag$("DISABLED", "false"))
                editing% = 0
            END IF
        END IF
    RETURN
    '-----
    MainLoop_SkipPermanentHandler:

