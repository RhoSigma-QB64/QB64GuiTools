                        NewTag$("WIDTH", "44") +_
                        NewTag$("HEIGHT", "44") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Marble.jpg") +_
                        NewTag$("TOOLTIP", "Delete selected Station") +_
                        ImageTag$(StationsDeleteImage$))
                StationsGotoButton$ = ButtonC$("INIT",_
                        ViewTag$(StationsView&) +_
                        NewTag$("LEFT", "73") +_
                        NewTag$("TOP", "211") +_
                        NewTag$("WIDTH", "44") +_
                        NewTag$("HEIGHT", "44") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Marble.jpg") +_
                        NewTag$("TOOLTIP", "Switch to selected Station") +_
                        ImageTag$(StationsGotoImage$))
                StationsImportButton$ = ButtonC$("INIT",_
                        ViewTag$(StationsView&) +_
                        NewTag$("LEFT", "23") +_
                        NewTag$("TOP", "261") +_
                        NewTag$("WIDTH", "44") +_
                        NewTag$("HEIGHT", "44") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Marble.jpg") +_
                        NewTag$("TOOLTIP", "Add or Import new Station(s)") +_
                        ImageTag$(StationsImportImage$))
                StationsChangeButton$ = ButtonC$("INIT",_
                        ViewTag$(StationsView&) +_
                        NewTag$("LEFT", "73") +_
                        NewTag$("TOP", "261") +_
                        NewTag$("WIDTH", "44") +_
                        NewTag$("HEIGHT", "44") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Marble.jpg") +_
                        NewTag$("TOOLTIP", "Edit selected Station") +_
                        ImageTag$(StationsChangeImage$))
            END IF
            ok$ = GenC$("SET", StationsListListview$ + NewTag$("ACTUAL", LTRIM$(STR$(opts.idxStation))))
            OpenGuiView "", "", StationsView&
        END IF
        '--- Settings View Events ---
        IF ThisObject%(SettingsScrollStationCheckbox$, mess$, "GADGETUP") THEN
            opts.scrStation = BoolTagTrue%(GenC$("GET", SettingsScrollStationCheckbox$), "CHECKED")
            temp$ = GetObjTagData$(MainStationText$, "TEXT", ""): deli% = INSTR(temp$, " - - - - - ")
            IF deli% > 0 THEN temp$ = LEFT$(temp$, deli% - 1)
            IF opts.scrStation THEN
                WHILE _UPRINTWIDTH(temp$, 8) < 400: temp$ = temp$ + " - - - - - " + temp$: WEND
            END IF
            ok$ = GenC$("SET", MainStationText$ + NewTag$("TEXT", temp$))
        END IF
        IF ThisObject%(SettingsScrollFeedsCheckbox$, mess$, "GADGETUP") THEN
            opts.scrFeeds = BoolTagTrue%(GenC$("GET", SettingsScrollFeedsCheckbox$), "CHECKED")
            temp$ = GetObjTagData$(MainFeedsText$, "TEXT", ""): deli% = INSTR(temp$, " - - - - - ")
            IF deli% > 0 THEN temp$ = LEFT$(temp$, deli% - 1)
            IF opts.scrFeeds THEN
                WHILE _UPRINTWIDTH(temp$, 8) < 400: temp$ = temp$ + " - - - - - " + temp$: WEND
            END IF
            ok$ = GenC$("SET", MainFeedsText$ + NewTag$("TEXT", temp$))
        END IF
        IF ThisObject%(SettingsResetVolumeCheckbox$, mess$, "GADGETUP") THEN
            opts.volReset = BoolTagTrue%(GenC$("GET", SettingsResetVolumeCheckbox$), "CHECKED")
        END IF
        IF ThisObject%(SettingsVolumeSlider$, mess$, "GADGETUP") THEN
            opts.volStart = VAL(GetObjTagData$(SettingsVolumeSlider$, "LEVEL", "67"))
        END IF
        IF ThisObject%(SettingsBufferSlider$, mess$, "GADGETUP") THEN
            opts.bufSize = VAL(GetObjTagData$(SettingsBufferSlider$, "LEVEL", "50"))
        END IF
        IF ThisObject%(SettingsAutoPlayCheckbox$, mess$, "GADGETUP") THEN
            opts.autoPlay = BoolTagTrue%(GenC$("GET", SettingsAutoPlayCheckbox$), "CHECKED")
        END IF
        IF ThisObject%(SettingsAutoRetryCheckbox$, mess$, "GADGETUP") THEN
            opts.autoRetry = BoolTagTrue%(GenC$("GET", SettingsAutoRetryCheckbox$), "CHECKED")
        END IF
        IF ThisObject%(SettingsNoWarningCheckbox$, mess$, "GADGETUP") THEN
            opts.chgQuiet = BoolTagTrue%(GenC$("GET", SettingsNoWarningCheckbox$), "CHECKED")
        END IF
        IF ThisObject%(SettingsRememberStationCheckbox$, mess$, "GADGETUP") THEN
            opts.remStation = BoolTagTrue%(GenC$("GET", SettingsRememberStationCheckbox$), "CHECKED")
        END IF
        '--- Info View Events ---
        IF ThisObject%(InfoCopyButton$, mess$, "GADGETUP") THEN
            url$ = GetObjTagData$(InfoUrlText$, "TEXT", "")
            IF LCASE$(LEFT$(url$, 4)) <> "http" THEN url$ = "http://" + url$
            IF INSTR(8, url$, "/") = 0 THEN url$ = url$ + "/"
            _CLIPBOARD$ = url$
            ok$ = GenC$("SET", InfoCopyButton$ + ImageTag$(InfoCopyImage$))
        END IF
        IF ThisObject%(InfoOpenButton$, mess$, "GADGETUP") THEN
            url$ = GetObjTagData$(InfoUrlText$, "TEXT", "")
            IF LCASE$(LEFT$(url$, 4)) <> "http" THEN url$ = "http://" + url$
            IF INSTR(8, url$, "/") = 0 THEN url$ = url$ + "/"
            SHELL _HIDE _DONTWAIT url$
        END IF
        '--- Recent View Events ---
        IF ThisObject%(RecentFavoriteButton$, mess$, "GADGETUP") THEN
            AddMarkRecent "*****"
        END IF
        IF ThisObject%(RecentSaveAsButton$, mess$, "GADGETUP") THEN
            GOSUB saveRecentDirect
        END IF
        '--- Stations View Events ---
        IF ThisObject%(StationsDeleteButton$, mess$, "GADGETUP") THEN
            IF VAL(GetObjTagData$(StationsList$, "RECORDS", "1")) > 1 THEN
                result$ = MessageBox$("", appExeName$,_
                                      "Are you sure deleting that Station?",_
                                      "{SYM Checkmark * * * *}Yes||{SYM Cross * * * *}No")
                IF result$ = "Yes" THEN
                    curPlayAct% = opts.idxStation
                    curPlayNam$ = GetTagData$(ListC$("READ", StationsList$ + NewTag$("ACTUAL", LTRIM$(STR$(opts.idxStation)))), "DATA", "")
                    delStation$ = GetObjTagData$(StationsListListview$, "ACTUAL", "0")
                    ok$ = ListC$("DELETE", StationsList$ + NewTag$("ACTUAL", delStation$))
                    IF VAL(delStation$) <> curPlayAct% THEN ok$ = ListC$("SEARCH", StationsList$ + NewTag$("DATA", curPlayNam$) + NewTag$("HOLD", "true"))
                    opts.idxStation = VAL(GetObjTagData$(StationsList$, "ACTUAL", "0"))
                    ok$ = GenC$("SET", StationsListListview$ + NewTag$("ACTUAL", LTRIM$(STR$(opts.idxStation))))
                    IF VAL(delStation$) = curPlayAct% GOTO gotoButtonAction
                END IF
            ELSE
                ok$ = MessageBox$("", appExeName$,_
                        "Sorry, you cannot delete the last remaining Station.",_
                        "{IMG Error16px.png 0}Ok, got it...")
            END IF
        END IF
        IF ThisObject%(StationsGotoButton$, mess$, "GADGETUP") THEN
            gotoButtonAction:
            wasPlaying% = nowPlaying% 'remember
            IF nowPlaying% THEN
                GOSUB togglePlayingState: GOSUB stopPlay
                ok$ = GenC$("SET", MainFeedsText$ + NewTag$("TEXT", ""))
            END IF
            opts.idxStation = VAL(GetObjTagData$(StationsListListview$, "ACTUAL", "0"))
            temp$ = GetTagData$(ListC$("READ", StationsList$ + NewTag$("ACTUAL", LTRIM$(STR$(opts.idxStation)))), "DATA", "")
            IF opts.scrStation THEN WHILE _UPRINTWIDTH(temp$, 8) < 400: temp$ = temp$ + " - - - - - " + temp$: WEND
            ok$ = GenC$("SET", MainStationText$ + NewTag$("TEXT", temp$))
            IF oldLevel% <> 0 THEN 'restore volume, if muted or fading was in progress
                ok$ = GenC$("SET", MainVolumeSlider$ + NewTag$("LEVEL", LTRIM$(STR$(ABS(oldLevel%)))))
                oldLevel% = 0
            END IF
            IF opts.volReset AND VAL(GetObjTagData$(MainVolumeSlider$, "LEVEL", "67")) > opts.volStart THEN
                ok$ = GenC$("SET", MainVolumeSlider$ + NewTag$("LEVEL", LTRIM$(STR$(opts.volStart))))
            END IF
            IF opts.autoPlay AND wasPlaying% THEN
                record$ = ListC$("READ", StationsList$ + NewTag$("ACTUAL", LTRIM$(STR$(opts.idxStation))))
                streamUrl$ = GetTagData$(record$, "STREAM_URL", "")
                advertTxt$ = GetTagData$(record$, "ADVERT_TEXT", "")
                metaDelay$ = GetTagData$(record$, "META_DELAY", "1")
                IF streamUrl$ <> "" THEN
                    redirects% = 0: GOSUB startPlay: IF stream& <> 0 THEN GOSUB togglePlayingState
                END IF
            ELSE
                ok$ = GenC$("SET", MainFeedsText$ + NewTag$("TEXT", "press play to listen..."))
            END IF
        END IF
        IF ThisObject%(StationsImportButton$, mess$, "GADGETUP") THEN
            ok$ = MessageBox$("", appExeName$,_
                    "What exacly you wanna do?|" +_
                    "- Add a new Station and manually enter its details.|" +_
                    "- Import Stations from a .m3u, .m3u8 or .pls file.",_
                    "{IMG Add16px.png 0}Manual Add|{IMG Import16px.png 0}Import File|{IMG Cancel16px.png 0}Forget it!")
            IF ok$ = "Manual Add" THEN
                curPlayNam$ = GetTagData$(ListC$("READ", StationsList$ + NewTag$("ACTUAL", LTRIM$(STR$(opts.idxStation)))), "DATA", "")
                ok$ = ListC$("STORE", StationsList$ + NewTag$("DATA", "New Station"))
                ok$ = ListC$("SEARCH", StationsList$ + NewTag$("DATA", curPlayNam$) + NewTag$("HOLD", "true"))
                opts.idxStation = VAL(GetObjTagData$(StationsList$, "ACTUAL", "0"))
                ok$ = ListC$("SEARCH", StationsList$ + NewTag$("DATA", "New Station") + NewTag$("HOLD", "true"))
                ok$ = GenC$("SET", StationsListListview$ + NewTag$("ACTUAL", GetObjTagData$(StationsList$, "ACTUAL", "0")))
                GOTO changeButtonAction
            ELSEIF ok$ = "Import File" THEN
                m3uFile$ = FileSelect$("", "Select a downloaded *.m3u, *.m3u8 or *.pls file...", fsmLOAD%, _DIR$("Downloads"), "")
                IF LEN(m3uFile$) > 0 THEN
                    ext$ = LCASE$(FileExtension$(m3uFile$))
                    IF ext$ <> ".m3u" AND ext$ <> ".m3u8" AND ext$ <> ".pls" THEN
                        result$ = MessageBox$("", appExeName$,_
                                              "Your choice is not a *.m3u, *.m3u8 or *.pls file.||" +_
                                              "However, if it's the file you got from the Radio|" +_
                                              "Station its website, then it still might contain|" +_
                                              "the required data for import. Wrong files should|" +_
                                              "import nothing at best, but in worst INetRadio|" +_
                                              "may error out and then quit.||" +_
                                              "Are you sure to process the selected file?",_
                                              "{SYM Checkmark * * * *}Yes||{SYM Cross * * * *}No")
                        IF result$ = "No" THEN m3uFile$ = ""
                    END IF
                    m3u% = SafeOpenFile%("I", m3uFile$)
                    IF m3u% <> 0 THEN
                        IF LOF(m3u%) THEN
                            curPlayNam$ = GetTagData$(ListC$("READ", StationsList$ + NewTag$("ACTUAL", LTRIM$(STR$(opts.idxStation)))), "DATA", "")
                            LINE INPUT #m3u%, dat$
                            IF UCASE$(dat$) = "#EXTM3U" THEN
                                WHILE NOT EOF(m3u%)
                                    LINE INPUT #m3u%, ext$
                                    IF UCASE$(LEFT$(ext$, 7)) = "#EXTINF" THEN
                                        importProcessEXTINF:
                                        ext$ = LTRIM$(RTRIM$(MID$(ext$, INSTR(ext$, ",") + 1)))
                                        DO
                                            IF EOF(m3u%) THEN EXIT WHILE
                                            LINE INPUT #m3u%, dat$
                                            IF LCASE$(LEFT$(dat$, 4)) = "http" THEN
                                                GOSUB importUpdateList
                                            ELSEIF UCASE$(LEFT$(dat$, 7)) = "#EXTINF" THEN
                                                ext$ = dat$: GOTO importProcessEXTINF
                                            END IF
                                        LOOP
                                    END IF
                                WEND
                            ELSEIF LCASE$(dat$) = "[playlist]" THEN
                                num% = 0
                                DO
                                    IF num% THEN ext$ = " (" + LTRIM$(STR$(num%)) + ")": ELSE ext$ = ""
                                    IF LCASE$(LEFT$(dat$, 4)) = "file" THEN
                                        dat$ = LTRIM$(RTRIM$(MID$(dat$, INSTR(dat$, "=") + 1)))
                                        IF LCASE$(LEFT$(dat$, 4)) = "http" THEN
                                            ext$ = LTRIM$(RTRIM$(FilePart$(m3uFile$))) + ext$
                                            GOSUB importUpdateList
                                            num% = num% + 1
                                        END IF
                                    END IF
                                    IF EOF(m3u%) THEN EXIT DO
                                    LINE INPUT #m3u%, dat$
                                LOOP
                            ELSE
                                num% = 0
                                DO
                                    IF num% THEN ext$ = " (" + LTRIM$(STR$(num%)) + ")": ELSE ext$ = ""
                                    IF LCASE$(LEFT$(dat$, 4)) = "http" THEN
                                        ext$ = LTRIM$(RTRIM$(FilePart$(m3uFile$))) + ext$
                                        GOSUB importUpdateList
                                        num% = num% + 1
                                    END IF
                                    IF EOF(m3u%) THEN EXIT DO
                                    LINE INPUT #m3u%, dat$
                                LOOP
                            END IF
                            GOTO importSkipUpdateList
                            importUpdateList:
                                colon% = INSTR(7, dat$, ":"): IF colon% > 0 THEN dat$ = LEFT$(dat$, colon% - 1)
                                slash% = INSTR(9, dat$, "/"): IF slash% = 0 THEN dat$ = dat$ + "/"
                                IF _UPRINTWIDTH(ext$, 8) = 0 THEN ext$ = AnsiTextToUtf8Text$(ext$, "Win1252")
                                ok$ = ListC$("STORE", StationsList$ + NewTag$("DATA", ext$) + NewTag$("STREAM_URL", dat$))
                                ok$ = ListC$("SEARCH", StationsList$ + NewTag$("DATA", curPlayNam$) + NewTag$("HOLD", "true"))
                                opts.idxStation = VAL(GetObjTagData$(StationsList$, "ACTUAL", "0"))
                                ok$ = GenC$("SET", StationsListListview$ + NewTag$("ACTUAL", LTRIM$(STR$(opts.idxStation))))
                            RETURN
                            importSkipUpdateList:
                        END IF
                    END IF
                    CLOSE m3u%
                END IF
            END IF
        END IF
        IF ThisObject%(StationsChangeButton$, mess$, "GADGETUP") THEN
            changeButtonAction:
            IF EditView& = 0 THEN
                rawAhead# = 1.8: GOSUB mp3decode: rawAhead# = 0.3
                EditView& = CreateGuiView& ("Station Details", 550, 286)
                EditBackImage$ = ImageC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("IMAGEFILE", "Back.jpg") +_
                        NewTag$("BACKFILL", "true") +_
                        NewTag$("AREA", "false") +_
                        NewTag$("LEFT", "0") +_
                        NewTag$("TOP", "0"))
                EditLogoImage$ = ImageC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("LEFT", "5") +_
                        NewTag$("TOP", "35") +_
                        NewTag$("WIDTH", "130") +_
                        NewTag$("HEIGHT", "141") +_
                        NewTag$("STANDALONE", "true") +_
                        NewTag$("CLEARCOLOR", "0") +_
                        NewTag$("TOOLTIP", "Adjust the|Station's details") +_
                        NewTag$("IMAGEFILE", "Editing.png"))
                '--- Editor fields ---
                EditFrame$ = FrameC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("LEFT", "140") +_
                        NewTag$("TOP", "12") +_
                        NewTag$("WIDTH", "398") +_
                        NewTag$("HEIGHT", "264") +_
                        NewTag$("FORM", "solid"))
                EditNameString$ = StringC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("LEFT", "154") +_
                        NewTag$("TOP", "47") +_
                        NewTag$("WIDTH", "370") +_
                        NewTag$("HEIGHT", "32") +_
                        NewTag$("TEXTPLACE", "center") +_
                        NewTag$("LABEL", "Station Name") +_
                        NewTag$("LABELPLACE", "above") +_
                        NewTag$("TOOLTIP", "The name shown in the -Radio Station- field|and in the Stations Manager list.") +_
                        NewTag$("FORM", "ridge") +_
                        NewTag$("PASSIVE", "true") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Tissue.jpg"))
                EditUrlString$ = StringC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("LEFT", "154") +_
                        NewTag$("TOP", "108") +_
                        NewTag$("WIDTH", "370") +_
                        NewTag$("HEIGHT", "32") +_
                        NewTag$("TEXTPLACE", "center") +_
                        NewTag$("LABEL", "Stream URL") +_
                        NewTag$("LABELPLACE", "above") +_
                        NewTag$("TOOLTIP", "To listen we need to connect|to this internet address.") +_
                        NewTag$("FORM", "ridge") +_
                        NewTag$("PASSIVE", "true") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Tissue.jpg"))
                EditAdvertString$ = StringC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("LEFT", "154") +_
                        NewTag$("TOP", "169") +_
                        NewTag$("WIDTH", "370") +_
                        NewTag$("HEIGHT", "32") +_
                        NewTag$("TEXTPLACE", "center") +_
                        NewTag$("LABEL", "Mute Advertisement Text") +_
                        NewTag$("LABELPLACE", "above") +_
                        NewTag$("TOOLTIP", "If given, then playback is auto-muted while|the received feed contains this text(part).") +_
                        NewTag$("FORM", "ridge") +_
                        NewTag$("PASSIVE", "true") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Tissue.jpg"))
                EditDelayString$ = StringC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("LEFT", "154") +_
                        NewTag$("TOP", "230") +_
                        NewTag$("WIDTH", "370") +_
                        NewTag$("HEIGHT", "32") +_
                        NewTag$("TEXTPLACE", "center") +_
                        NewTag$("LABEL", "Feeds Display Delay (10 = 1 second)") +_
                        NewTag$("LABELPLACE", "above") +_
                        NewTag$("TOOLTIP", "Delay from receiving a new feed until displaying it.|This is required for precise auto-mute.") +_
                        NewTag$("FORM", "ridge") +_
                        NewTag$("ALLOWED", "0123456789") +_
                        NewTag$("MAXIMUM", "3") +_
                        NewTag$("PASSIVE", "true") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Tissue.jpg"))
                '--- Toolbar ---
                EditToolRuler$ = RulerC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("LEFT", "10") +_
                        NewTag$("TOP", "224") +_
                        NewTag$("LENGTH", "120") +_
                        NewTag$("FORM", "ridge"))
                EditOkImage$ = ImageC$("INIT", MainToolimageCommon$ +_
                        ViewTag$(EditView&) +_
                        NewTag$("IMAGEFILE", "Ok32px.png"))
                EditCancelImage$ = ImageC$("INIT", MainToolimageCommon$ +_
                        ViewTag$(EditView&) +_
                        NewTag$("IMAGEFILE", "Cancel32px.png"))
                EditOkButton$ = ButtonC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("LEFT", "23") +_
                        NewTag$("TOP", "235") +_
                        NewTag$("WIDTH", "44") +_
                        NewTag$("HEIGHT", "44") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Marble.jpg") +_
                        NewTag$("TOOLTIP", "Confirm inputs") +_
                        ImageTag$(EditOkImage$))
                EditCancelButton$ = ButtonC$("INIT",_
                        ViewTag$(EditView&) +_
                        NewTag$("LEFT", "73") +_
                        NewTag$("TOP", "235") +_
                        NewTag$("WIDTH", "44") +_
                        NewTag$("HEIGHT", "44") +_
                        NewTag$("AREA", "true") +_
                        NewTag$("IMAGEFILE", "Marble.jpg") +_
                        NewTag$("TOOLTIP", "Cancel editing") +_
                        ImageTag$(EditCancelImage$))
            END IF
            ok$ = GenC$("SET", StationsDeleteButton$ + NewTag$("DISABLED", "true"))
            ok$ = GenC$("SET", StationsImportButton$ + NewTag$("DISABLED", "true"))
            ok$ = GenC$("SET", StationsChangeButton$ + NewTag$("DISABLED", "true"))
            selRecord$ = GenC$("GET", StationsListListview$ + NewTag$("TAGNAMES", "DATA,STREAM_URL,ADVERT_TEXT,META_DELAY"))
            oldName$ = GetTagData$(selRecord$, "DATA", "")
            oldUrl$ = GetTagData$(selRecord$, "STREAM_URL", "")
            oldAdvert$ = GetTagData$(selRecord$, "ADVERT_TEXT", "")
            oldDelay$ = GetTagData$(selRecord$, "META_DELAY", "")
            ok$ = GenC$("SET", EditNameString$ + NewTag$("TEXT", oldName$))
            ok$ = GenC$("SET", EditUrlString$ + NewTag$("TEXT", oldUrl$))
            ok$ = GenC$("SET", EditAdvertString$ + NewTag$("TEXT", oldAdvert$))
            ok$ = GenC$("SET", EditDelayString$ + NewTag$("TEXT", oldDelay$))
            OpenGuiView "", "", EditView&
            editing% = -1
        END IF
        '--- Edit View Events ---
        IF ThisObject%(EditOkButton$, mess$, "GADGETUP") THEN
            CloseGuiView EditView&
            newName$ = LTRIM$(RTRIM$(GetTagData$(GenC$("GET", EditNameString$), "TEXT", "")))
            IF _UPRINTWIDTH(newName$, 8) = 0 THEN newName$ = AnsiTextToUtf8Text$(newName$, "")
            newUrl$ = LTRIM$(RTRIM$(GetTagData$(GenC$("GET", EditUrlString$), "TEXT", "")))
            IF LCASE$(LEFT$(newUrl$, 4)) <> "http" THEN newUrl$ = "http://" + newUrl$
            IF INSTR(8, newUrl$, "/") = 0 THEN newUrl$ = newUrl$ + "/"
            newAdvert$ = LTRIM$(RTRIM$(GetTagData$(GenC$("GET", EditAdvertString$), "TEXT", "")))
            newDelay$ = LTRIM$(RTRIM$(GetTagData$(GenC$("GET", EditDelayString$), "TEXT", "")))
            IF newName$ <> oldName$ OR newUrl$ <> oldUrl$ OR newAdvert$ <> oldAdvert$ OR newDelay$ <> oldDelay$ THEN
                curPlayNam$ = GetTagData$(ListC$("READ", StationsList$ + NewTag$("ACTUAL", LTRIM$(STR$(opts.idxStation)))), "DATA", "")
                ok$ = ListC$("SEARCH", StationsList$ + NewTag$("DATA", oldName$) + NewTag$("HOLD", "true"))
                ok$ = ListC$("DELETE", StationsList$)
                ok$ = ListC$("STORE", StationsList$ + NewTag$("DATA", newName$) + NewTag$("STREAM_URL", newUrl$) + NewTag$("ADVERT_TEXT", newAdvert$) + NewTag$("META_DELAY", newDelay$))
                ok$ = ListC$("SEARCH", StationsList$ + NewTag$("DATA", newName$) + NewTag$("HOLD", "true"))
                ok$ = GenC$("SET", StationsListListview$ + NewTag$("ACTUAL", GetObjTagData$(StationsList$, "ACTUAL", "0")))
                ok$ = ListC$("SEARCH", StationsList$ + NewTag$("DATA", curPlayNam$) + NewTag$("HOLD", "true"))
                IF oldName$ = curPlayNam$ THEN
                    ok$ = ListC$("SEARCH", StationsList$ + NewTag$("DATA", newName$) + NewTag$("HOLD", "true"))
                    ok$ = GenC$("SET", MainStationText$ + NewTag$("TEXT", newName$))
                    advertTxt$ = newAdvert$: metaDelay$ = newDelay$
                END IF
                opts.idxStation = VAL(GetObjTagData$(StationsList$, "ACTUAL", "0"))
                IF oldName$ = curPlayNam$ AND newUrl$ <> oldUrl$ THEN mess$ = "": GOTO gotoButtonAction
            END IF
        END IF
        IF ThisObject%(EditCancelButton$, mess$, "GADGETUP") THEN
            CloseGuiView EditView&
        END IF
    END IF

